# Серверные секреты (не коммитить .env). Используются Express / Render.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.5-flash

# Vision OCR для прикреплённых PDF-сканов и изображений (отдельно от генерации листа)
CONTEXT_OCR_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# CONTEXT_PDF_MAX_PAGES=3
# CONTEXT_EXTRACT_TIMEOUT_MS=300000

PORT=3001

# Опционально: публичный URL сервиса (для заголовка OpenRouter)
# APP_URL=https://your-service.onrender.com
