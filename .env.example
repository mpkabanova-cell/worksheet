# Серверные секреты (не коммитить .env). Используются Express / Render.
OPENAI_API_KEY=
# Альias (как в OCR-подпроекте): если задан только OPENROUTER_API_KEY, сервер тоже подхватит
# OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.0-flash-001

# Подсказка для фронта (тот же slug, что на сервере): не слать json_object для Gemini
VITE_OPENAI_MODEL=google/gemini-2.0-flash-001

# Vision OCR для прикреплённых файлов (Qwen-VL, все форматы)
CONTEXT_OCR_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# 0 или пусто = все страницы PDF (макс. 200); 3 = только первые 3 (быстрее для тестов)
CONTEXT_PDF_MAX_PAGES=0
# PDF: sparse = vision только на страницах с мало текста (быстро для PDF с текстовым слоем)
# PDF_VISION_MODE=sparse
# PDF_PAGE_TEXT_MIN=120
# PDF_VISION_CONCURRENCY=3
# PDF_SCREENSHOT_SCALE=1.25
# PDF_EXTRACT_TEXT_LAYER=0  # отключить текстовый слой pdf-parse
CONTEXT_EXTRACT_TIMEOUT_MS=300000

PORT=3001

# Опционально: публичный URL сервиса (для заголовка OpenRouter)
# APP_URL=https://worksheet-rphn.onrender.com
